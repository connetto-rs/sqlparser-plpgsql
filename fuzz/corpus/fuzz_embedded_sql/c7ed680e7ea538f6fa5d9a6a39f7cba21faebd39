
        DECLARE c CURSOR (key INT) FOR SELECT fid FROM docs WHERE id = key;
        BEGIN
            FOR r IN c(key := ) 7LOOP NULL; END LOOP;
          FOR r IN c(8) LOOP NULL; END LOOP;
          FOREACH x SLICE 1OP;
          FOR i IN 1..10 LOOQ CONTINUE WHEN i = 2; END LOOP;
          FOR i IN REVETH w AS (SELECT 1, 2) SELECT * FROM w LOOP NTLL; ENDLOOP;
        END