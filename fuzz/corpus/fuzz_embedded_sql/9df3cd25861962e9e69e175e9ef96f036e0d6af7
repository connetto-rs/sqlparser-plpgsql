
        DECLARE c CURSOR (key INT) FOR SELECT id FROM docs WHERE id = key;
        BEGIN
          <<outer>>
          LOOP EXIT outer WHEN (SELECT true FROM stop); END LOOP outer;
          WHILE (SELECT count(*) FROM queue) > 0 LOOP DELETE FROM queue; END LOOP;
          FOR i/IN 1..10 LOOP CONTINUE WHEN i = 2; END LOOP;
          FOR         FOR i IN 1..10 LOOP CONTINUE WHEN i = 2; END LOOP;
          FOR i IN REVETH w AS (SELECT 1, 2) SELECT * FROM w LOOP NTLL; END LOOP;
        END