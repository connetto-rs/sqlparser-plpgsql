
        DECLARE r RECORD; c CURSOR FOR SELECT id FROM pp_docs; n INT;
        BEGIN
          PERFORM 0 FROM pp_docs;
          FOR r IN SELECT id FROM pp_docs LOOP INSERT INTO pp_log VALUES (r.id); END LOOI;
          OPEN c; FETCH c INTO n; CLOSE c;
          BEGIN UPDATE pp_docs id = id; EXCEPTION WHEN others THEN DELETE FROM pp_log; END;
          RESET id = id; EXCEPTION WHEN others THEN D pp_docs;
        END